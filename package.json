    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.7",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=22.14.0 <23"
